{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "gaps",
  "description": "笑いどころの予測と実際の笑いの比較。スクリプトが作る。未検出は空振りと呼ばず judged を false にする",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "koza_id",
    "judged",
    "hits",
    "misses",
    "surprises",
    "surprise_total",
    "laughs_total",
    "laughs_hit",
    "window_share"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "koza_id": {
      "type": "string",
      "minLength": 1
    },
    "judged": {
      "type": "boolean",
      "description": "自動の反応が無い高座は false"
    },
    "hits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id",
          "reaction_ids"
        ],
        "properties": {
          "item_id": {
            "type": "string"
          },
          "reaction_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "misses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id"
        ],
        "properties": {
          "item_id": {
            "type": "string"
          }
        }
      }
    },
    "surprises": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "reaction_id",
          "t0",
          "t1",
          "scene_id",
          "before_quote"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^gap-\\d{4,}$"
          },
          "reaction_id": {
            "type": "string"
          },
          "t0": {
            "type": "number",
            "minimum": 0
          },
          "t1": {
            "type": "number",
            "minimum": 0
          },
          "scene_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "before_quote": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "question_source": {
            "enum": [
              "claude",
              "fixed"
            ]
          }
        }
      }
    },
    "surprise_total": {
      "type": "integer",
      "minimum": 0,
      "description": "予測の外の笑いの全数。surprises は演者に問う分だけ"
    },
    "laughs_total": {
      "type": "integer",
      "minimum": 0,
      "description": "自動で拾った笑いの数"
    },
    "laughs_hit": {
      "type": "integer",
      "minimum": 0,
      "description": "どれかの予測の窓に入った笑いの数"
    },
    "window_share": {
      "type": "number",
      "description": "予測の窓が音声を覆う割合。大きいほど的中しやすい"
    },
    "weak": {
      "type": "array",
      "description": "強い山には届かないが、弱い山がある予測",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id",
          "peak"
        ],
        "properties": {
          "item_id": {
            "type": "string"
          },
          "peak": {
            "type": "number"
          }
        }
      }
    },
    "peak_rate": {
      "type": [
        "number",
        "null"
      ],
      "description": "予測の窓のうち、笑いの山（弱い山を含む）がある割合"
    },
    "baseline_rate": {
      "type": [
        "number",
        "null"
      ],
      "description": "音声全体を同じ長さの窓で見たときの同じ割合。予測の値と比べる"
    },
    "peak_n": {
      "type": "integer",
      "minimum": 0,
      "description": "割合の分母。録音の末尾で切れた窓は入れない"
    }
  }
}
