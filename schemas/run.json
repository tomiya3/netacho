{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "run",
  "description": "実測の数字。推定は書かない",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "koza_id",
    "roles",
    "total_cost_usd",
    "total_seconds"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "koza_id": {
      "type": "string",
      "minLength": 1
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "model",
          "calls",
          "input_tokens",
          "output_tokens",
          "cache_read_input_tokens",
          "cache_creation_input_tokens",
          "cost_usd",
          "seconds"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "calls": {
            "type": "integer",
            "minimum": 0
          },
          "input_tokens": {
            "type": "integer",
            "minimum": 0
          },
          "output_tokens": {
            "type": "integer",
            "minimum": 0
          },
          "cache_read_input_tokens": {
            "type": "integer",
            "minimum": 0
          },
          "cache_creation_input_tokens": {
            "type": "integer",
            "minimum": 0
          },
          "cost_usd": {
            "type": "number"
          },
          "seconds": {
            "type": "number"
          }
        }
      }
    },
    "total_cost_usd": {
      "type": "number"
    },
    "total_seconds": {
      "type": "number"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kept",
        "dropped"
      ],
      "properties": {
        "kept": {
          "type": "integer",
          "minimum": 0
        },
        "dropped": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "held_internal_id": {
          "type": "integer",
          "minimum": 0,
          "description": "今の帳面で、文に内部の番号が残って保留の項目の数（この実行の分ではない）"
        }
      },
      "description": "根拠の検証で残した数と、理由ごとに落とした数"
    },
    "checker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supported",
        "weak",
        "unsupported",
        "unchecked_knowledge"
      ],
      "properties": {
        "supported": {
          "type": "integer",
          "minimum": 0
        },
        "weak": {
          "type": "integer",
          "minimum": 0
        },
        "unsupported": {
          "type": "integer",
          "minimum": 0
        },
        "unchecked_knowledge": {
          "type": "integer",
          "minimum": 0
        },
        "no_verdict": {
          "type": "integer",
          "minimum": 0
        },
        "ma_by_script": {
          "type": "integer",
          "minimum": 0,
          "description": "照合役に回さず、スクリプトの検証で通した間の数"
        }
      }
    },
    "deshi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "round1",
        "round2",
        "dropped_no_anchor"
      ],
      "properties": {
        "round1": {
          "type": "integer",
          "minimum": 0
        },
        "round2": {
          "type": [
            "integer",
            "null"
          ]
        },
        "dropped_no_anchor": {
          "type": "integer",
          "minimum": 0
        },
        "reread": {
          "type": "integer",
          "minimum": 0,
          "description": "直近の読み直しの指摘数"
        },
        "suppressed_answered": {
          "type": "integer",
          "minimum": 0,
          "description": "答え済みの所への指摘を足さなかった数"
        }
      }
    },
    "questions": {
      "type": "integer",
      "minimum": 0
    },
    "guide_performer_cards": {
      "type": "integer",
      "minimum": 0
    },
    "notes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidates",
        "fallback"
      ],
      "properties": {
        "candidates": {
          "type": "integer",
          "minimum": 0
        },
        "fallback": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "prep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audio_seconds",
        "transcribe_seconds",
        "reactions_seconds"
      ],
      "properties": {
        "audio_seconds": {
          "type": "number",
          "minimum": 0
        },
        "transcribe_seconds": {
          "type": "number",
          "minimum": 0
        },
        "reactions_seconds": {
          "type": "number",
          "minimum": 0
        }
      },
      "description": "prep の実測。文字起こしと反応の検出にかかった秒数"
    },
    "gaps": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hit",
        "miss",
        "surprise",
        "hit_rate",
        "laughs_total",
        "laughs_hit",
        "window_share"
      ],
      "description": "笑いどころの予測と実際の比較",
      "properties": {
        "hit": {
          "type": "integer",
          "minimum": 0
        },
        "miss": {
          "type": "integer",
          "minimum": 0
        },
        "surprise": {
          "type": "integer",
          "minimum": 0
        },
        "hit_rate": {
          "type": [
            "number",
            "null"
          ]
        },
        "laughs_total": {
          "type": "integer",
          "minimum": 0
        },
        "laughs_hit": {
          "type": "integer",
          "minimum": 0
        },
        "window_share": {
          "type": "number"
        },
        "weak": {
          "type": "integer",
          "minimum": 0
        },
        "peak_rate": {
          "type": [
            "number",
            "null"
          ]
        },
        "baseline_rate": {
          "type": [
            "number",
            "null"
          ]
        },
        "peak_n": {
          "type": "integer",
          "minimum": 0
        },
        "humps_total": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "音声全体の笑いの山の数。0.08 以上のスコアのひと続きを 1 つとする。末尾で切れた窓に触れる山は入れない。自動の笑いかスコアが無い高座は null"
        },
        "humps_hit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "どれかの予測の窓に入った山の数。同じ山に窓が重なっても 1 つ"
        },
        "humps_expected": {
          "type": [
            "number",
            "null"
          ],
          "description": "同じ長さの窓を音声全体に一様に置いたときに入る山の割合の見込み。山の幅を入れて計算する。山が 0 個のとき、音声の長さが無いとき、判定しない高座は null",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "seisho": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lines",
        "changed",
        "kept_raw",
        "missing",
        "extra",
        "duplicate",
        "empty",
        "heavy",
        "unknown_speaker"
      ],
      "properties": {
        "lines": {
          "type": "integer",
          "minimum": 0
        },
        "changed": {
          "type": "integer",
          "minimum": 0
        },
        "kept_raw": {
          "type": "integer",
          "minimum": 0
        },
        "missing": {
          "type": "integer",
          "minimum": 0
        },
        "extra": {
          "type": "integer",
          "minimum": 0
        },
        "duplicate": {
          "type": "integer",
          "minimum": 0
        },
        "empty": {
          "type": "integer",
          "minimum": 0
        },
        "heavy": {
          "type": "integer",
          "minimum": 0
        },
        "unknown_speaker": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
