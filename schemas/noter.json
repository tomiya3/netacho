{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "noter",
  "description": "ノート役の出力",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "text"
        ],
        "properties": {
          "candidate_id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      }
    }
  }
}
