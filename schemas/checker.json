{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "checker",
  "description": "照合役の出力",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "verdicts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "verdicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id",
          "verdict",
          "reason"
        ],
        "properties": {
          "item_id": {
            "type": "string"
          },
          "verdict": {
            "enum": [
              "supported",
              "weak",
              "unsupported"
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  }
}
