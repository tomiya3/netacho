{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "transcript",
  "description": "文字起こし。時刻は wav の先頭（抜粋なら抜粋の先頭）からの秒",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "koza_id",
    "model",
    "language",
    "segments",
    "vad"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "koza_id": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "start",
          "end",
          "text",
          "words",
          "no_speech_prob",
          "pause_after"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^seg-\\d{4,}$"
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "minimum": 0
          },
          "text": {
            "type": "string"
          },
          "words": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "start",
                "end",
                "word",
                "p"
              ],
              "properties": {
                "start": {
                  "type": "number",
                  "minimum": 0
                },
                "end": {
                  "type": "number",
                  "minimum": 0
                },
                "word": {
                  "type": "string"
                },
                "p": {
                  "type": "number"
                }
              }
            }
          },
          "no_speech_prob": {
            "type": "number"
          },
          "pause_after": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    },
    "vad": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "start",
          "end"
        ],
        "properties": {
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    }
  }
}
