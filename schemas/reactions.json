{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "reactions",
  "description": "反応の候補。強さは同じ高座の中の順位（1 が最も強い）。未検出は反応なしを意味しない",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "koza_id",
    "reactions",
    "hints",
    "music",
    "scores"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "koza_id": {
      "type": "string",
      "minLength": 1
    },
    "params": {
      "type": "object"
    },
    "reactions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "t0",
          "t1",
          "kind",
          "strength_rank",
          "method"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^react-\\d{4,}$"
          },
          "t0": {
            "type": "number",
            "minimum": 0
          },
          "t1": {
            "type": "number",
            "minimum": 0
          },
          "kind": {
            "enum": [
              "laugh",
              "applause",
              "reaction"
            ],
            "description": "自動は laugh か applause。手で付けたものは reaction"
          },
          "strength_rank": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "description": "同じ高座の中の順位。手で付けて順位を書かなければ null"
          },
          "method": {
            "enum": [
              "auto",
              "manual"
            ]
          }
        }
      }
    },
    "hints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "t0",
          "t1",
          "seg_id"
        ],
        "properties": {
          "kind": {
            "enum": [
              "long_pause",
              "vad_no_text"
            ]
          },
          "t0": {
            "type": "number",
            "minimum": 0
          },
          "t1": {
            "type": "number",
            "minimum": 0
          },
          "seg_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^seg-\\d{4,}$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "music": {
      "type": "array",
      "description": "音楽の候補。判定には使わず、別に残すだけ",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "t0",
          "t1",
          "score"
        ],
        "properties": {
          "t0": {
            "type": "number",
            "minimum": 0
          },
          "t1": {
            "type": "number",
            "minimum": 0
          },
          "score": {
            "type": "number"
          }
        }
      }
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "description": "AST の窓ごとのスコア。画面の波に使う",
      "required": [
        "window",
        "stride",
        "seconds",
        "laugh",
        "applause",
        "music"
      ],
      "properties": {
        "window": {
          "type": "number"
        },
        "stride": {
          "type": "number"
        },
        "laugh": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "applause": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "music": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "seconds": {
          "type": "number",
          "minimum": 0,
          "description": "音声の長さ（秒）"
        }
      }
    }
  }
}
