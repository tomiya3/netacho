{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "koza",
  "description": "高座 1 回の情報",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "date",
    "venue",
    "neta",
    "performer_id",
    "audio_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "venue": {
      "type": "string",
      "minLength": 1
    },
    "neta": {
      "type": "string",
      "minLength": 1
    },
    "performer_id": {
      "type": "string",
      "minLength": 1
    },
    "audio_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "excerpt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "to": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    }
  }
}
